{
  "name": "shortage",
  "version": "1.4.0",
  "productName": "Shortage",
  "description": "Samostatná offline aplikace Shortage pro Windows",
  "private": true,
  "main": "desktop/main.cjs",
  "author": "ecko456",
  "repository": {
    "type": "git",
    "url": "https://github.com/ecko456/shortage.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "node tests/e2e.cjs",
    "dist:win": "electron-builder --win portable --x64 --publish never",
    "dist:zip": "electron-builder --win zip --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "jsqr": "1.4.0",
    "playwright": "1.65.0"
  },
  "build": {
    "appId": "cz.ecko456.shortage",
    "productName": "Shortage",
    "artifactName": "Shortage-${version}-Windows-x64.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "desktop/**/*",
      "package.json",
      "THIRD_PARTY.md"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false,
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "requestExecutionLevel": "user"
    }
  }
}
